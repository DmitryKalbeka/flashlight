{
  "name": "@perf-profiler/measure2",
  "version": "0.1.0",
  "license": "MIT",
  "bin": {
    "perf-profiler-measure": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pkg:all": "pkg dist/bin.js --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output flashlight",
    "pkg:mac": "pkg dist/bin.js --targets node18-macos-x64 --config pkg-config.json --output flashlight",
    "build:lerna": "lerna run build"
  },
  "dependencies": {
    "@perf-profiler/ios-instruments": "^0.3.3",
    "@perf-profiler/logger": "^0.3.3",
    "@perf-profiler/profiler": "^0.10.11",
    "@perf-profiler/reporter": "^0.9.0",
    "@perf-profiler/types": "^0.8.0",
    "@perf-profiler/adb-builder": "^0.1.0",
    "commander": "^12.0.0"
  }
}
